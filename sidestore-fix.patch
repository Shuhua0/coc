diff -ruN -x '*.png' a/clash_widgets/PersistentStore.swift b/clash_widgets/PersistentStore.swift
--- a/clash_widgets/PersistentStore.swift	2026-10-11 18:41:34.889336640 +0000
+++ b/clash_widgets/PersistentStore.swift	2026-10-11 18:41:34.953792950 +0000
@@ -1,7 +1,35 @@
 import Foundation
 
 struct PersistentStore {
-    static let appGroupIdentifier = "group.Zachary-Buschmann.clash-widgets"
+    /// 원 개발자의 App Group (정식 서명 빌드에서만 그대로 유지됨)
+    static let defaultAppGroupIdentifier = "group.Zachary-Buschmann.clash-widgets"
+
+    /// SideStore/AltStore로 재서명하면 App Group 이름이 바뀌므로, 실행 중에 실제 값을 찾아서 사용
+    static let appGroupIdentifier: String = resolveAppGroupIdentifier()
+
+    private static func resolveAppGroupIdentifier() -> String {
+        // 1) SideStore/AltStore가 Info.plist에 넣어주는 실제 App Group 이름
+        if let groups = Bundle.main.object(forInfoDictionaryKey: "ALTAppGroups") as? [String],
+           let first = groups.first(where: { !$0.isEmpty }) {
+            return first
+        }
+        // 2) 임베디드 프로비저닝 프로파일의 entitlements에서 읽기
+        if let path = Bundle.main.path(forResource: "embedded", ofType: "mobileprovision"),
+           let data = try? Data(contentsOf: URL(fileURLWithPath: path)),
+           let start = data.range(of: Data("<?xml".utf8)),
+           let end = data.range(of: Data("</plist>".utf8)),
+           start.lowerBound < end.upperBound {
+            let plistData = data.subdata(in: start.lowerBound..<end.upperBound)
+            if let plist = try? PropertyListSerialization.propertyList(from: plistData, options: [], format: nil) as? [String: Any],
+               let entitlements = plist["Entitlements"] as? [String: Any],
+               let groups = entitlements["com.apple.security.application-groups"] as? [String],
+               let first = groups.first(where: { !$0.isEmpty }) {
+                return first
+            }
+        }
+        // 3) 기본값
+        return defaultAppGroupIdentifier
+    }
     private static let directoryName = "ClashboardData"
     private static let fileName = "app_state.json"
 
